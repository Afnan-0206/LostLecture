# ==============================================================================
# lostLecture Server Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual environment values.
# NEVER commit or expose the actual .env file in version control!
# ==============================================================================

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/lostlecture
CLIENT_URL=http://localhost:5173

# --- Cryptographic Secrets ---
# In production, all secrets must be unique, high-entropy 256-bit random strings.
# COOKIE_ENCRYPTION_SECRET strictly requires a 64-character hexadecimal string representing 32 random bytes.
# Generate each secret securely via terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_64_hex_chars_generate_with_crypto_randomBytes
CSRF_SECRET=your_csrf_secret_64_hex_chars_generate_with_crypto_randomBytes
COOKIE_ENCRYPTION_SECRET=your_cookie_encryption_secret_64_hex_chars_generate_with_crypto_randomBytes

# --- Legacy Cookie Migration Configuration ---
# Safe migration policy: Legacy plaintext JWT cookies are REJECTED BY DEFAULT (false).
# During a rolling deployment or user migration, explicitly set to 'true' for a temporary window (max 7 days).
# After all users have acquired encrypted cookies, remove this variable or set to 'false'.
ALLOW_LEGACY_COOKIE_AUTH=false

# Optional migration deadline: Automatically rejects legacy cookies after this timestamp even if flag is true.
# Format: ISO-8601 string (e.g. 2026-11-10T00:00:00.000Z) or epoch milliseconds.
# LEGACY_COOKIE_MIGRATION_DEADLINE=2026-11-10T00:00:00.000Z

# --- Cloudinary Media Storage (Optional in Dev / Required for Production Uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
